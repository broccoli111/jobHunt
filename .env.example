# Vercel Postgres (auto-injected when you connect Storage → Postgres to your project)
POSTGRES_URL=

# Optional override — not needed if POSTGRES_URL is set by Vercel
# DATABASE_URL=

# Secures /api/refresh when called manually (Vercel Cron uses x-vercel-cron header)
CRON_SECRET=your-random-secret-here

# Optional: key for manual refresh from dashboard (sent as x-refresh-key header)
REFRESH_API_KEY=your-manual-refresh-key

# Optional: Finnhub API key for more reliable stock prices
# FINNHUB_API_KEY=

# Optional: JSearch API key for Indeed / Google Jobs listings (https://www.openwebninja.com/api/jsearch)
# JSEARCH_API_KEY=
