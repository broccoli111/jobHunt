# Postgres — use ONE of these (Vercel Postgres auto-injects POSTGRES_URL when you connect Storage)
DATABASE_URL=postgresql://user:password@host:5432/jobHunt
# POSTGRES_URL=          # Vercel Postgres (preferred on Vercel — no rename needed)
# POSTGRES_PRISMA_URL=   # Also supported

# Secures /api/refresh when called manually (Vercel Cron uses x-vercel-cron header)
CRON_SECRET=your-random-secret-here

# Optional: key for manual refresh from dashboard (sent as x-refresh-key header)
REFRESH_API_KEY=your-manual-refresh-key

# Optional: Finnhub API key for more reliable stock prices
# FINNHUB_API_KEY=

# Optional: Levels.fyi or similar compensation API
# LEVELS_FYI_API_KEY=
